# Supabase — leave as placeholders (or remove) for local demo auth.
# Replace with real keys from supabase.com/dashboard to enable production auth.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for signed session cookies (any random string locally)
AUTH_SECRET=change-me-to-a-long-random-string

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (confirmation emails)
# Sign up: https://resend.com — free tier includes test sending
RESEND_API_KEY=re_...
# Use onboarding@resend.dev for testing (only delivers to your Resend account email)
# For production, verify your domain and use e.g. Elsewhere China <bookings@yourdomain.com>
EMAIL_FROM=Elsewhere China <onboarding@resend.dev>
NEXT_PUBLIC_CONTACT_EMAIL=hello@elsewherechina.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (required for sign-in; use a long random string in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Covers live in public/images/workshops/ — run scripts/download-workshop-images.sh for real photos
